# ====================================================================
# PlagiCheck - Environment Variables & API Configuration
# ====================================================================

# 1. External API Key (Optional)
# Paste your Gemini API key, OpenAI API key, or custom plagiarism detection API key here:
VITE_API_KEY="YOUR_API_KEY_HERE"

# 2. Custom API Endpoint (Optional - only needed if you have a custom backend)
# Example: VITE_API_ENDPOINT="https://my-backend-server.com/api/check"
VITE_API_ENDPOINT=""

# 3. Gemini Server-Side API Key (Configured in AI Studio Secrets)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# 4. App URL (Injected by runtime)
APP_URL="MY_APP_URL"
