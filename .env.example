# =================================================================
# PLAGICHECK - HARDENED PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and replace placeholders with high-entropy production secrets.
# NEVER commit the active .env file to version control.
# =================================================================

# -----------------------------------------------------------------
# 1. Flask Application Environment
# -----------------------------------------------------------------
FLASK_ENV=production
FLASK_DEBUG=false
FLASK_APP=backend.app:create_app

# Cryptographic Master Secrets (Generate using: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=REPLACE_WITH_CRYPTOGRAPHICALLY_RANDOM_64_CHAR_HEX_SECRET
JWT_SECRET_KEY=REPLACE_WITH_CRYPTOGRAPHICALLY_RANDOM_64_CHAR_HEX_SECRET

# -----------------------------------------------------------------
# 2. MySQL Database Hardened Application Connection (Least-Privilege)
# -----------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=plagicheck_db
DB_USER=plagicheck_app
DB_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD_FROM_SECURITY_SETUP_SQL

# Optional complete URI override (uncomment if using cloud database like AWS RDS / Google Cloud SQL):
# DATABASE_URL=mysql+pymysql://plagicheck_app:PASSWORD@127.0.0.1:3306/plagicheck_db?charset=utf8mb4&ssl_ca=/path/to/ca.pem

# Connection Pool Limits (Anti-Starvation DoS)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# -----------------------------------------------------------------
# 3. Authentication & Session Cookies (OWASP ASVS Compliant)
# -----------------------------------------------------------------
JWT_EXPIRY_MINUTES=120
JWT_REFRESH_DAYS=7
COOKIE_SECURE=true
JWT_COOKIE_SAMESITE=Lax

# Argon2id Parameters
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# -----------------------------------------------------------------
# 4. Email OTP / 2-Factor Authentication (SMTP Configuration)
# Mode Selection:
# - DEVELOPMENT: Set FLASK_ENV=development (or leave SMTP_HOST empty).
#   OTP is displayed in the dev banner and logged to the terminal for local testing.
# - PRODUCTION: Set FLASK_ENV=production.
#   Real SMTP credentials are mandatory. OTP display and logging are completely disabled.
# -----------------------------------------------------------------
FLASK_ENV=development
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@yourdomain.edu
SMTP_PASSWORD=your_app_specific_email_password
SMTP_USE_TLS=true
MAIL_DEFAULT_SENDER="PlagiCheck Security <security@plagicheck.university.edu>"
SMTP_FROM_EMAIL=security@plagicheck.university.edu
OTP_EXPIRY_MINUTES=5

# -----------------------------------------------------------------
# 4. File Upload Limits & Document Storage
# -----------------------------------------------------------------
MAX_UPLOAD_SIZE=26214400 # 25 MB in bytes
MAX_DOCUMENT_WORDS=10000

# -----------------------------------------------------------------
# 5. Network & CORS Allowed Origins
# -----------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://plagicheck.university.edu
RATELIMIT_DEFAULT=100 per minute

# -----------------------------------------------------------------
# 6. Encrypted Database Backups (AES-256 Fernet Key)
# Generate using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# -----------------------------------------------------------------
BACKUP_ENCRYPTION_KEY=REPLACE_WITH_FERNET_AES_256_BASE64_KEY

# -----------------------------------------------------------------
# 7. Frontend Vite Settings
# -----------------------------------------------------------------
VITE_API_ENDPOINT=/api/winston/v2/ai-content-detection
VITE_API_KEY=
VITE_API_PROVIDER=winston
